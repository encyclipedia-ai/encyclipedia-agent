{
  "name": "@encyclipedia-ai/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Encylipedia Helper: install on a customer computer so YouTube downloads happen on their network, then cloud workers render clips.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "encyclipedia-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "install.sh",
    "install.ps1"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
