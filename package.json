{
  "name": "@encyclipedia-ai/agent",
  "version": "1.0.1",
  "private": true,
  "description": "Encyclipedia Librarian desktop app: securely download source media on the customer's computer.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/electron-main.js",
  "bin": {
    "encyclipedia-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "ui",
    "install.sh",
    "install.ps1"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "app": "tsc -p tsconfig.json && electron .",
    "dist:mac": "tsc -p tsconfig.json && electron-builder --mac --universal --publish never",
    "dist:win": "tsc -p tsconfig.json && electron-builder --win --publish never",
    "dist:linux": "tsc -p tsconfig.json && electron-builder --linux --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/job-queue.test.ts test/update-gate.test.ts test/release-manifest.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "ai.encyclipedia.helper",
    "productName": "Encyclipedia - Librarian",
    "executableName": "encyclipedia-librarian",
    "directories": {
      "output": "release"
    },
    "artifactName": "Encyclipedia-Librarian-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "ui/**/*",
      "build/icon.png"
    ],
    "afterSign": "scripts/notarize.cjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://downloads.encyclipedia.ai/librarian/"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/generated/icons/mac/icon.icns",
      "extendInfo": {
        "CFBundleDisplayName": "Encyclipedia - Librarian",
        "CFBundleName": "Encyclipedia - Librarian"
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/generated/icons/win/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Video"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^22.10.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
